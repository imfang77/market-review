<title>20260824 5-20日主线分析（按概念/题材） | A股复盘选股中心</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family: system-ui,-apple-system,"Segoe UI","Microsoft YaHei",sans-serif; background:#f0f2f5; color:#1a1a2e; }
  .header { background:#fff; border-bottom:1px solid #e9ecef; padding:40px 16px 14px; text-align:center; box-shadow:0 1px 3px rgba(0,0,0,.05); position:relative; }
  .header .back { position:absolute; left:12px; top:12px; font-size:13px; color:#4263eb; text-decoration:none; white-space:nowrap; }
  .header h1 { font-size:20px; font-weight:700; }
  .header .subtitle { margin-top:4px; font-size:13px; color:#868e96; }
  .header .report-date { margin-top:8px; font-size:15px; color:#495057; font-weight:600; }
  .container { max-width:860px; margin:24px auto; padding:0 16px 60px; }
  .section { background:#fff; border:1px solid #e9ecef; border-radius:12px; padding:20px; margin-bottom:20px; }
  .part-header { font-size:20px; font-weight:800; color:#1a1a2e; margin:8px 0 14px; padding-bottom:8px; border-bottom:2px solid #4263eb; }
  .part-header .date-range { font-size:13px; color:#868e96; font-weight:400; margin-left:8px; }
  .market-env { background:#f8f9fa; border-radius:8px; padding:12px 14px; font-size:14px; line-height:1.7; color:#495057; margin-bottom:16px; }
  .section-title { font-size:16px; font-weight:700; margin:6px 0 12px; color:#1a1a2e; }
  .section-title.cand-title { margin-top:18px; color:#1565c0; }
  .theme-details { border-radius:8px; margin-bottom:14px; border:1px solid #e9ecef; }
  .theme-details.dt-main { border-left:5px solid #c62828; background:#fff6f5; }
  .theme-details.dt-cand { border-left:5px solid #1565c0; background:#f5f9ff; }
  .theme-summary { font-size:15px; font-weight:700; margin:0; cursor:pointer; list-style:none; user-select:none; padding:14px 16px 14px 30px; position:relative; display:flex; align-items:baseline; flex-wrap:wrap; }
  .theme-summary::-webkit-details-marker { display:none; }
  .theme-summary::before { content:"▸ "; position:absolute; left:14px; top:14px; color:#868e96; font-weight:400; }
  .theme-details[open] > summary.theme-summary::before { content:"▾ "; }
  .theme-role { flex:0 0 auto; min-width:62px; }
  .theme-name-wrap { flex:1 1 auto; min-width:0; white-space:nowrap; overflow:visible; }
  .theme-meta { font-size:12px; font-weight:400; color:#495057; margin-left:6px; }
  .theme-meta b { font-weight:700; }
  .theme-type { font-size:11px; padding:2px 8px; border-radius:4px; font-weight:600; margin-right:6px; }
  .type-role-main { background:#c62828; color:#fff; }
  .type-role-cand { background:#1565c0; color:#fff; }
  .type-rebound { background:#e67e22; color:#fff; }
  .type-shock { background:#6c757d; color:#fff; }
  .theme-data .data-row { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:8px; }
  .theme-data .data-item { background:#fff; border:1px solid #e9ecef; padding:2px 10px; border-radius:14px; font-size:12px; white-space:nowrap; }
  .theme-data { padding:0 16px 14px; }
  .lead-line { font-size:13px; color:#495057; margin-bottom:6px; }
  .lead-line .lbl { color:#868e96; }
  .lead-line b { font-weight:700; }
  .stock-code { font-family:"SF Mono",Consolas,monospace; font-size:11px; color:#868e96; display:block; margin-top:2px; white-space:nowrap; }
  /* 个股名称强制单行不换行（与按行业报告一致）；核心个股明细表 / ETF表 字号继承全局 table（桌面13px / 手机10px），不额外放大，保证两报告一致且不溢出 */
  .stock-table td.stock-name { font-weight:600; white-space:nowrap; }
  .logic { font-size:13px; color:#495057; line-height:1.7; }
  .logic b { color:#1a1a2e; }
  .data-basis-title { font-size:14px; font-weight:700; color:#1a1a2e; margin:18px 0 10px; }
  .basis-details { border:1px solid #e9ecef; border-radius:8px; background:#fff; margin-top:18px; }
  .basis-summary { font-size:14px; font-weight:700; color:#1a1a2e; padding:14px 16px; cursor:pointer; list-style:none; user-select:none; }
  .basis-summary::-webkit-details-marker { display:none; }
  .basis-summary::before { content:"▸ "; color:#868e96; font-weight:400; }
  .basis-details[open] > .basis-summary::before { content:"▾ "; }
  .basis-details > .table-wrap, .basis-details > table { padding:0 16px 14px; }
  .legend-details { border:1px solid #e9ecef; border-radius:8px; background:#fff; margin-top:14px; }
  .legend-summary { font-size:14px; font-weight:700; color:#1a1a2e; padding:14px 16px; cursor:pointer; list-style:none; user-select:none; }
  .legend-summary::-webkit-details-marker { display:none; }
  .legend-summary::before { content:"▸ "; color:#868e96; font-weight:400; }
  .legend-details[open] > .legend-summary::before { content:"▾ "; }
  .legend-body { padding:0 16px 14px; font-size:13px; color:#495057; line-height:1.7; }
  .legend-body p { margin:8px 0; }
  .legend-body b { color:#1a1a2e; }
  .legend-body ul { margin:6px 0 6px 20px; padding:0; }
  .legend-body li { margin:4px 0; }
  .table-wrap { overflow-x:auto; }
  table { border-collapse:collapse; width:100%; table-layout:auto; font-size:13px; }
  .idx-table { table-layout:fixed; }
  th, td { padding:8px 10px; text-align:center; border-bottom:1px solid #f1f3f5; vertical-align:middle; }
  th { white-space:normal; word-break:break-word; }
  td { white-space:nowrap; }
  th { background:#f8f9fa; color:#495057; font-weight:600; cursor:pointer; user-select:none; }
  /* 数字列居右（文本列保持居中）：指数/概念板块排行/个股明细表 */
  .idx-table td:nth-child(n+2),
  .rank-table td:nth-child(1), .rank-table td:nth-child(3), .rank-table td:nth-child(4), .rank-table td:nth-child(5),
  .stock-table { table-layout:fixed; }
  .stock-table td { white-space:normal; word-break:break-word; }
  .stock-table td:nth-child(2), .stock-table td:nth-child(3), .stock-table td:nth-child(4) { text-align:right; white-space:nowrap !important; word-break:normal !important; }
  th.sortable { cursor:pointer; user-select:none; transition:background .15s; }
  th.sortable:hover { color:#4263eb; }
  th.sortable::after { content:" \21C5"; font-size:10px; opacity:.35; font-weight:normal; }
  th.sortable.asc::after { content:" \2191"; opacity:1; color:#4263eb; font-weight:700; }
  th.sortable.desc::after { content:" \2193"; opacity:1; color:#4263eb; font-weight:700; }
  .up { color:#d63031; font-weight:700; }
  .down { color:#00b894; font-weight:700; }
  .lead-cell { text-align:center; font-size:12px; color:#495057; white-space:normal; }
  .stock-table-title { font-size:12px; font-weight:700; color:#4263eb; margin:12px 0 6px; }
  .stock-section { margin-top:12px; }
  .stock-section > summary.stock-section-title { font-size:12px; font-weight:700; color:#4263eb; margin:0 0 6px; cursor:pointer; list-style:none; user-select:none; }
  .stock-section > summary.stock-section-title::-webkit-details-marker { display:none; }
  .stock-section > summary.stock-section-title::before { content:"▸ "; }
  .stock-section[open] > summary.stock-section-title::before { content:"▾ "; }
  .etf-section { margin-top:14px; border-top:1px dashed #e9ecef; padding-top:10px; }
  .etf-section > summary.etf-section-title { font-size:12px; font-weight:700; color:#4263eb; margin:0 0 8px; cursor:pointer; list-style:none; user-select:none; }
  .etf-section > summary.etf-section-title::-webkit-details-marker { display:none; }
  .etf-section > summary.etf-section-title::before { content:"▸ "; }
  .etf-section[open] > summary.etf-section-title::before { content:"▾ "; }
  .etf-table { table-layout:fixed; }
  /* 字体与「核心个股明细」表完全一致：不单独指定字号，继承全局 table（桌面13px / 手机10px），避免手机端偏大 */
  .etf-table th, .etf-table td { padding:6px 8px; text-align:center; border-bottom:1px solid #f1f3f5; vertical-align:middle; white-space:normal; word-break:break-word; }
  .etf-table th { background:#f8f9fa; color:#495057; font-weight:600; cursor:pointer; }
  .etf-table td.stock-name { text-align:left; font-weight:600; white-space:nowrap; }
  .etf-table td.chg-cell { white-space:nowrap !important; word-break:normal !important; }
  .etf-table td.holds-cell { text-align:left; white-space:normal; vertical-align:top; }
  .etf-empty { font-size:12px; color:#868e96; padding:6px 2px; }
  .holds-detail { margin:0; }
  .holds-detail > summary { cursor:pointer; color:#4263eb; font-size:9px; font-weight:600; list-style:none; padding:2px 0; user-select:none; white-space:nowrap; }
  .holds-detail > summary::-webkit-details-marker { display:none; }
  .holds-detail > summary::before { content:"▸ "; }
  .holds-detail[open] > summary::before { content:"▾ "; }
  .holds-detail[open] > summary { margin-bottom:4px; }
  .holds-list { margin-top:2px; }
  .hold-row { display:flex; justify-content:space-between; align-items:center; gap:10px; font-size:11px; line-height:1.5; padding:1px 0; white-space:nowrap; }
  .hold-row.core { background:#fff6f5; border-radius:3px; }
  .hold-row .hn { font-weight:600; color:#495057; }
  .hold-row .hr { color:#868e96; font-variant-numeric:tabular-nums; }
  .etf-table .core-tag { display:inline-block; font-size:10px; padding:0 5px; border-radius:3px; background:#c62828; color:#fff; margin-left:3px; font-weight:600; vertical-align:middle; }
  .note-cell { text-align:center; vertical-align:middle; white-space:normal; padding: 6px 4px; }
  .rank-tags { display:flex; flex-wrap:wrap; gap:4px; justify-content:center; }
  .rt { display:inline-block; font-size:10px; padding:1px 5px; border-radius:3px; margin:2px 3px 2px 0; font-weight:600; white-space:nowrap; }
  /* 备注标签：与数据单元格同色调浅背景 + 深一档字体色（可读）；市值深红、成交额深蓝、涨幅深粉 */
  .rt-gain { background:#f8bbd0; color:#e91e63; }
  .rt-amt  { background:#bbdefb; color:#1565c0; }
  .rt-cap  { background:#c62828; color:#fff; }   /* 与 cell-cap(当日市值Top5) 深红底白字一致 */
  /* 核心个股明细：Top5 数据单元格用背景色标注（黑字默认），其余默认无背景
     市值Top5→深红(cell-cap) / 成交额Top5→蓝(cell-amt) / 涨幅Top5→粉(cell-gain)；备注标签同色调 */
  .stock-table td.cell-gain { background:#f8bbd0; }   /* 涨幅Top5 粉色背景 */
  .stock-table td.cell-amt  { background:#bbdefb; }   /* 成交额Top5 蓝色背景 */
  .stock-table td.cell-cap  { background:#c62828; color:#fff; }   /* 市值Top5 深红背景 + 白字 */
  .empty { color:#adb5bd; font-size:13px; padding:8px 0; }
  .footer { text-align:center; padding:20px; font-size:12px; color:#adb5bd; }
  @media (max-width:600px){ .container{padding:0 10px;} table{font-size:10px;} th,td{padding:6px 3px;} .stock-code{font-size:9px;} .table-wrap{overflow-x:auto;} .theme-summary{font-size:14px; padding:12px 14px 12px 30px;} .theme-summary::before{position:absolute; left:14px; top:12px;} .theme-role{flex:0 0 72px;} .theme-name-wrap{flex:1 1 auto; white-space:nowrap; overflow:visible;} .theme-meta{flex:0 0 calc(100% - 72px); margin-left:72px; margin-top:2px; white-space:nowrap; font-size:11px;} .basis-summary{position:relative; padding-left:30px;} .basis-summary::before{position:absolute; left:14px; top:14px;} .part-header{font-size:17px;} .part-header .date-range{font-size:12px;} }
</style>
</head>
