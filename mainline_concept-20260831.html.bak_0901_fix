ble th.sortable").forEach(function(th){th.onclick=function(){var k=th.getAttribute("data-k");var asc=th.classList.contains("asc");var tb=document.getElementById("basis-tbody");var rows=[].slice.call(tb.querySelectorAll("tr"));rows.sort(function(a,b){if(k==="name"){return asc?a.getAttribute("data-name").localeCompare(b.getAttribute("data-name")):b.getAttribute("data-name").localeCompare(a.getAttribute("data-name"));}var x=parseFloat(a.getAttribute("data-"+k));var y=parseFloat(b.getAttribute("data-"+k));if(isNaN(x))x=-1e9;if(isNaN(y))y=-1e9;return asc?x-y:y-x;});rows.forEach(function(r){tb.appendChild(r);});document.querySelectorAll("#basis-table th").forEach(function(t){t.classList.remove("asc","desc");});th.classList.add(asc?"desc":"asc");};});</script></body></html>