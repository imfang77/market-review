      </details>
      <details class="etf-section">
    <summary class="etf-section-title">相关ETF（名称/持仓匹配，当日成交额 > 0.5亿，共 12 只，点击展开）</summary>
    <div class="table-wrap"><table class="etf-table" id="etf-table-pt01850531-">
      <colgroup><col style="width:24%"><col style="width:11%"><col style="width:11%"><col style="width:12%"><col style="width:12%"><col style="width:12%"><col style="width:18%"></colgroup>
      <thead><tr>
        <th class="sortable">ETF（代码）</th>
        <th class="sortable">当日成交金额(亿)</th>
        <th class="sortable">总规模(亿)</th>
        <th class="sortable desc">当日<br>涨跌幅</th>
        <th class="sortable">5日<br>涨跌幅</th>
        <th class="sortable">10日<br>涨跌幅</th>
        <th class="sortable">十大持仓 / 说明</th>
